---
const inBlog = Astro.url.pathname.startsWith('/blog/');
---

<nav aria-label="Main navigation" class="site-nav">
  <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Home</a>
  <a href="/blog/" aria-current={inBlog ? 'page' : undefined}>Blog</a>
</nav>

<style>
  .site-nav { display: flex; gap: 1.5rem; font-size: 1rem; }
  a { color: var(--text-muted); text-decoration: none; padding-block: .3rem; border-bottom: 1px solid transparent; }
  a:hover, a[aria-current] { color: var(--heading); border-bottom-color: currentColor; }
</style>
